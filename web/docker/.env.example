# =============================================================================
# P4 Web — environment variable template
# =============================================================================
# Copy this file to web/docker/.env and fill in the values for your server.
# docker-compose reads .env automatically from the same directory.
#
# NEVER commit .env to git — it may contain paths pointing to licensed software.
# =============================================================================

# ── Maple ────────────────────────────────────────────────────────────────────
# Full path to the `maple` executable ON THE HOST.
# The host directory containing this binary is bind-mounted into the container
# at /opt/maple (read-only).  The container path is always /opt/maple/bin/maple.
#
# Maple's licence is node-locked to the host hardware, so it cannot be
# installed inside a Docker image; it must always run from the host filesystem.
#
# Examples:
#   Linux default:   /opt/maple/bin/maple
#   macOS Maple 2023: /Library/Frameworks/Maple.framework/Versions/2023/bin/maple
MAPLE_HOST_DIR=/opt/maple

# ── P4 binaries ───────────────────────────────────────────────────────────────
# Directory on the HOST where the P4 helper binaries live after running
# `make install` (or install_mac.sh) from the repo root.
# Inside the container this is mounted at /app/p4/bin (read-only).
#
# After a successful build the directory should contain:
#   lyapunov   lyapunov_mpf   separatrice   p4.m   p4gcf.m
#
# Default (relative to repo root, where install_mac.sh / make install deploys):
P4_HOST_BIN_DIR=../../p4/bin

# ── HTTP port (host-side) ─────────────────────────────────────────────────────
# The nginx container maps this host port to its internal port 80.
# Change to 8080 or similar if 80 is taken on the host.
HOST_PORT=80

# ── Crow / backend port (internal) ───────────────────────────────────────────
# Internal port the Crow C++ server listens on inside its container.
# nginx proxies to this; it is NOT exposed to the host directly.
# Change only if you have a port conflict inside the Docker network.
BACKEND_PORT=8080
